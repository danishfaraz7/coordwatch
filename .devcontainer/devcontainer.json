{
  "name": "coordwatch",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12",
  "postCreateCommand": "pip install requests Pillow telethon",
  "postAttachCommand": "python -m coordwatch web --host 0.0.0.0 --port 8000",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "coordwatch", "onAutoForward": "openBrowser", "visibility": "private" } },
  "customizations": { "vscode": { "extensions": ["ms-python.python"] } }
}
